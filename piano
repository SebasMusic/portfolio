        // Elementos DOM
        const modeSelect = document.getElementById('modeSelect');
        const chordInput = document.getElementById('chordInput');
        const inputLabel = document.getElementById('inputLabel');
        const generateBtn = document.getElementById('generateBtn');
        const styleSelect = document.getElementById('styleSelect');
        const labelType = document.getElementById('labelType');
        const showSemitones = document.getElementById('showSemitones');
        const pianoWrapper = document.getElementById('pianoWrapper');
        const semitoneInfo = document.getElementById('semitoneInfo');
        const downloadBtn = document.getElementById('downloadBtn');
        const openColorsBtn = document.getElementById('openColorsBtn');
        const colorModal = document.getElementById('colorModal');
        const closeColorsBtn = document.getElementById('closeColorsBtn');
        const resetColorsBtn = document.getElementById('resetColorsBtn');
        const colorGrid = document.getElementById('colorGrid');

        // Cambiar modo acorde/escala
        modeSelect.addEventListener('change', () => {
            if (modeSelect.value === 'scale') {
                inputLabel.textContent = "Escala (Ej: C mayor, A menor)";
                chordInput.value = "C mayor";
            } else {
                inputLabel.textContent = "Acorde (Ej: Cmaj7, Am, F#7)";
                chordInput.value = "Cmaj7";
            }
            generatePiano();
        });

        generateBtn.addEventListener('click', generatePiano);
        chordInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') generatePiano(); });
